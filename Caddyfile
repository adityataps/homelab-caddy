######################################
### Caddyfile for reverse proxying ###
######################################
{
	debug
	admin 0.0.0.0:{$CADDY_PORT:2019}

	crowdsec {
		api_url http://localhost:8080
		api_key {env.CROWDSEC_API_KEY}
		ticker_interval 15s
		appsec_url http://localhost:7422
		#disable_streaming
		#enable_hard_fails
	}

	layer4 {
		0.0.0.0:15672 {
			route {
				proxy upstream {$RABBITMQ_IP}:{$RABBITMQ_PORT:15672}
			}
		}
		0.0.0.0:5432 {
			route {
				proxy upstream {$POSTGRESQL_IP}:{$POSTGRESQL_PORT:5432}
			}
		}
		0.0.0.0:27017 {
			route {
				proxy upstream {$MONGODB_IP}:{$MONGODB_PORT:27017}
			}
		}
		0.0.0.0:6379 {
			route {
				proxy upstream {$REDIS_IP}:{$REDIS_PORT:6379}
			}
		}
	}
}

### Snippets ##########

# authentik forward auth via the embedded outpost (CT 145). Use inside a
# site's `route` block, after `crowdsec` and before `reverse_proxy`:
#   import authentik                 protect the whole site
#   import authentik /api/* /feed/*  protect all but these paths (only for
#                                    paths the app already gates with an API key)
(authentik) {
	reverse_proxy /outpost.goauthentik.io/* {$AUTHENTIK_IP}:{$AUTHENTIK_PORT:9000}
	@authentik_protected not path /outpost.goauthentik.io/* {args[:]}
	forward_auth @authentik_protected {$AUTHENTIK_IP}:{$AUTHENTIK_PORT:9000} {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Entitlements X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwks X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
		trusted_proxies private_ranges
	}
}

